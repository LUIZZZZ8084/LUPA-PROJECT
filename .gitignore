# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — nunca commitar segredos.
# O modelo sem valores (.env.example) é a exceção proposital.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testes
/coverage
/playwright-report
/test-results
/blob-report
/.stryker-tmp
/reports

# design-sync: scripts encenados, build regenerável e estado de máquina
.ds-sync/
ds-bundle/
# O diretório inteiro: com só os subdiretórios ignorados, o `npm run
# verify` local reprova no lint do CSS gerado pela ferramenta — e o
# vermelho não é do projeto. Na CI passa, porque lá o diretório não
# existe; quem paga é quem roda na própria máquina.
.design-sync/
/dist
