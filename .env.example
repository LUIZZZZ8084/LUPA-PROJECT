# ============================================================================
# LUPA — variáveis de ambiente
#
# Copie para `.env.local` e preencha. Sem estas variáveis o app roda em modo
# demonstração, com os dados de Sinop em src/lib/mock-data.ts.
# ============================================================================

# Modo demonstração: número que recebe os contatos de WhatsApp no lugar dos
# prestadores de exemplo (que têm telefones fictícios, mas plausíveis — sem
# isso, a mensagem iria para um desconhecido). Formato: 5566999990000.
# Sem esta variável, o botão de contato fica desativado na demonstração.
NEXT_PUBLIC_LUPA_DEMO_WHATSAPP=

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço: SOMENTE no servidor, nunca com prefixo NEXT_PUBLIC_.
# Usada por rotinas administrativas que precisam furar o RLS.
SUPABASE_SERVICE_ROLE_KEY=

# E-mail transacional (V0). Push segmentada fica para o V1.
RESEND_API_KEY=

# URL pública do app: a raiz dos links que saem daqui para fora — o webhook
# e os back_urls do Mercado Pago, e o link do e-mail de recuperação.
#
# Em produção ela é OBRIGATÓRIA e o app recusa subir sem ela (#195). Antes
# disso, faltando, caía em VERCEL_URL — que nunca é o domínio próprio, e sim
# a URL gerada do deploy, diferente a cada publicação. Custou a primeira
# venda de verdade da Lupa: o Mercado Pago aprovou e mandou o aviso para um
# endereço que não era o nosso, e a cobrança ficou pendente para sempre.
#
# Em preview a Vercel deduz sozinha, e ali está certo. Localmente, vazio
# significa http://localhost:3000.
NEXT_PUBLIC_APP_URL=

# Mercado Pago — cobrança de assinatura e avulsa.
# Sem MERCADO_PAGO_ACCESS_TOKEN, o app cai em modo demonstração de
# pagamento: aprova a cobrança na hora, sem falar com o Mercado Pago —
# mesmo padrão do resto do app sem Supabase configurado.
MERCADO_PAGO_ACCESS_TOKEN=
# Valida a assinatura (x-signature) do webhook. Sem ele, a rota de webhook
# recusa qualquer notificação — melhor não confirmar pagamento nenhum do
# que confirmar um que ninguém pode provar que veio do Mercado Pago.
MERCADO_PAGO_WEBHOOK_SECRET=

# Segredo de assinatura da sessão (JWT). Mínimo de 32 caracteres.
# Em produção, a aplicação recusa subir sem ele — segredo padrão no
# repositório significa sessão de admin forjável por qualquer um.
# Gere com: openssl rand -base64 48
SESSION_SECRET=

# Criação do administrador (scripts/criar-admin.mjs).
# A senha nunca é versionada; sem ADMIN_SENHA o script gera uma e imprime
# uma única vez.
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME=
ADMIN_TELEFONE=

# --- Avisos de vaga nova (#48) -----------------------------------------
# Gere o par com `node scripts/gerar-vapid.mjs` e cole aqui e na Vercel.
#
# Sem estas variáveis o push simplesmente não existe: a tela diz que o
# recurso não está no ar, em vez de aceitar a escolha e engolir. O resto
# do app roda igual — é a mesma degradação do Storage sem Supabase.
#
# A privada NUNCA leva prefixo NEXT_PUBLIC_. Quem a tiver manda
# notificação em nome da Lupa para qualquer aparelho inscrito.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
